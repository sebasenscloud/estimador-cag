# Modelo en formato LiteLLM "<proveedor>/<modelo>". Cambiar de proveedor es cambiar esta línea:
#   anthropic/claude-haiku-4-5   ó   openai/gpt-4o-mini
LLM_MODEL=anthropic/claude-haiku-4-5
# Reintentos de Instructor cuando la respuesta no cumple el schema
LLM_MAX_RETRIES=3

# Solo hace falta la API key del proveedor del modelo elegido
ANTHROPIC_API_KEY=tu-api-key-de-anthropic
OPENAI_API_KEY=tu-api-key-de-openai

APP_ENV=development
LOG_LEVEL=info
MAX_TOKENS=16000
CACHE_MAX_ENTRIES=128

# Dirección del servicio IA que usa el cliente Streamlit
ESTIMATOR_API_URL=http://127.0.0.1:8000
ESTIMATOR_API_TIMEOUT=300

# Versión de las plantillas de prompt (carpeta en app/prompts/estimation/)
PROMPT_VERSION=v1

# Output guardrail: duración máxima antes de considerar el pedido fuera de scope
SCOPE_MAX_WEEKS=104

# Adjuntos. ATTACHMENT_STRATEGY: auto (el router elige por documento),
# local_text (siempre extracción local) o multimodal (PDFs siempre al LLM).
ATTACHMENT_STRATEGY=auto
# Camino multimodal: inline (base64 en el mensaje) o files_api (subida al proveedor).
ATTACHMENT_MULTIMODAL_MODE=inline
