# Proveedor activo: anthropic u openai
LLM_PROVIDER=anthropic
# Modelo del proveedor elegido (ej. claude-haiku-4-5 para anthropic, gpt-4o-mini para openai)
LLM_MODEL=claude-haiku-4-5

# Solo hace falta la API key del proveedor activo
ANTHROPIC_API_KEY=tu-api-key-de-anthropic
OPENAI_API_KEY=tu-api-key-de-openai

APP_ENV=development
LOG_LEVEL=info
MAX_TOKENS=16000
CACHE_MAX_ENTRIES=128

# Dirección del servicio IA que usa el cliente Streamlit
ESTIMATOR_API_URL=http://127.0.0.1:8000
ESTIMATOR_API_TIMEOUT=300

# Versión de las plantillas de prompt (carpeta en app/prompts/estimation/)
PROMPT_VERSION=v1
